<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ByeDPI.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/flow_primary</item>
        <item name="colorOnPrimary">@color/flow_on_primary</item>
        <item name="colorPrimaryContainer">@color/flow_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/flow_on_primary_container</item>
        <item name="colorSecondary">@color/flow_primary</item>
        <item name="colorOnSecondary">@color/flow_on_primary</item>
        <item name="colorSecondaryContainer">@color/flow_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/flow_on_primary_container</item>
        <item name="colorTertiary">@color/flow_connected</item>
        <item name="android:colorBackground">@color/flow_background</item>
        <item name="colorSurface">@color/flow_surface</item>
        <item name="colorOnSurface">@color/flow_text</item>
        <item name="colorOnSurfaceVariant">@color/flow_text_secondary</item>
        <item name="colorSurfaceVariant">@color/flow_surface_alt</item>
        <item name="colorSurfaceContainerLowest">@color/flow_surface</item>
        <item name="colorSurfaceContainerLow">@color/flow_surface</item>
        <item name="colorSurfaceContainer">@color/flow_surface</item>
        <item name="colorSurfaceContainerHigh">@color/flow_surface</item>
        <item name="colorSurfaceContainerHighest">@color/flow_surface_alt</item>
        <item name="colorOutline">@color/flow_ring_track</item>
        <item name="colorOutlineVariant">@color/flow_outline</item>
        <item name="android:statusBarColor">@color/flow_background</item>
        <item name="android:navigationBarColor">@color/flow_surface</item>
        <item name="android:windowLightStatusBar">@bool/flow_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/flow_light_bars</item>
    </style>

    <style name="Theme.ByeDPI" parent="Theme.ByeDPI.Base" />

    <style name="Theme.ByeDPI.Settings" parent="Theme.ByeDPI.Base">
        <item name="android:navigationBarColor">@color/flow_background</item>
    </style>

    <style name="Widget.FlowCloud.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">@color/flow_primary</item>
    </style>

    <style name="Widget.FlowCloud.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/flow_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/flow_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.FlowCloud.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.FlowCloud.RowIcon" parent="">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/bg_row_icon</item>
        <item name="android:padding">8dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/flow_primary</item>
    </style>

    <style name="Widget.FlowCloud.TextField" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/flow_surface_alt</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.FlowCloud.Segment" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_segment_item</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/flow_segment_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.FlowCloud.RowTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/flow_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.FlowCloud.RowSubtitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textColor">@color/flow_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.FlowCloud.Chevron" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:src">@drawable/ic_chevron_right_24</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/flow_text_secondary</item>
    </style>
</resources>
