<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flow_background"
    android:orientation="vertical"
    tools:context=".activities.MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Home -->
        <ScrollView
            android:id="@+id/home_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="@string/app_name"
                    android:textColor="@color/flow_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginTop="20dp">

                    <io.github.dovecoteescapee.byedpi.views.ConnectionRingView
                        android:id="@+id/connection_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:id="@+id/status_button"
                        android:layout_width="184dp"
                        android:layout_height="184dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_status_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/status_icon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_power_24"
                            app:tint="@color/flow_primary" />

                        <TextView
                            android:id="@+id/status_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:importantForAccessibility="no"
                            android:text="@string/vpn_connect"
                            android:textColor="@color/flow_primary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:textColor="@color/flow_text"
                    android:textSize="24sp"
                    tools:text="Не подключено" />

                <TextView
                    android:id="@+id/status_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:minHeight="20dp"
                    android:textColor="@color/flow_text_secondary"
                    android:textSize="14sp"
                    tools:text="Трафик идёт напрямую" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FlowCloud.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/connection_mode"
                            android:textColor="@color/flow_text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/transport_group"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_segment"
                            android:checkedButton="@id/mode_auto"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <RadioButton
                                android:id="@+id/mode_auto"
                                style="@style/Widget.FlowCloud.Segment"
                                android:text="@string/mode_auto" />

                            <RadioButton
                                android:id="@+id/mode_byedpi"
                                style="@style/Widget.FlowCloud.Segment"
                                android:layout_marginStart="4dp"
                                android:text="@string/mode_byedpi" />

                            <RadioButton
                                android:id="@+id/mode_warp"
                                style="@style/Widget.FlowCloud.Segment"
                                android:layout_marginStart="4dp"
                                android:text="@string/mode_warp" />
                        </RadioGroup>

                        <TextView
                            android:id="@+id/decision_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:drawablePadding="8dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/flow_text_secondary"
                            android:textSize="13sp"
                            app:drawableStartCompat="@drawable/ic_info_16"
                            app:drawableTint="@color/flow_text_secondary"
                            tools:text="@string/manual_auto" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- Settings tab -->
        <ScrollView
            android:id="@+id/settings_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/title_settings"
                    android:textColor="@color/flow_text"
                    android:textSize="28sp" />

                <TextView
                    style="@style/Widget.FlowCloud.SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_routing_section" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FlowCloud.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/split_tunneling_description"
                            android:textColor="@color/flow_text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/domain_rules_layout"
                            style="@style/Widget.FlowCloud.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:hint="@string/custom_domains_hint"
                            app:helperText="@string/custom_domains_helper">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/domain_rules_input"
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:gravity="top|start"
                                android:inputType="textMultiLine|textNoSuggestions"
                                android:scrollbars="vertical"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/network_rules_layout"
                            style="@style/Widget.FlowCloud.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/custom_networks_hint"
                            app:helperText="@string/custom_networks_helper">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/network_rules_input"
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:gravity="top|start"
                                android:inputType="textMultiLine|textNoSuggestions"
                                android:scrollbars="vertical"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/save_routing_rules_button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:text="@string/save_split_rules"
                            android:textAllCaps="false"
                            app:cornerRadius="14dp" />

                        <TextView
                            android:id="@+id/routing_rules_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:textColor="@color/flow_text_secondary"
                            android:textSize="13sp"
                            tools:text="Сохранено" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FlowCloud.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/select_excluded_apps_button"
                        style="@style/Widget.FlowCloud.Row">

                        <ImageView
                            style="@style/Widget.FlowCloud.RowIcon"
                            android:src="@drawable/ic_apps_24" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.FlowCloud.RowTitle"
                                android:text="@string/excluded_apps_title" />

                            <TextView
                                style="@style/Widget.FlowCloud.RowSubtitle"
                                android:text="@string/excluded_apps_short" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/excluded_apps_status"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge"
                            android:gravity="center"
                            android:minWidth="24dp"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:textColor="@color/flow_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="2" />

                        <ImageView
                            style="@style/Widget.FlowCloud.Chevron" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Widget.FlowCloud.SectionLabel"
                    android:layout_marginTop="20dp"
                    android:text="@string/updates" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FlowCloud.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/Widget.FlowCloud.Row"
                            android:background="@null">

                            <ImageView
                                style="@style/Widget.FlowCloud.RowIcon"
                                android:src="@drawable/ic_update_24" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Widget.FlowCloud.RowTitle"
                                    android:text="@string/automatic_update_checks" />

                                <TextView
                                    android:id="@+id/update_status"
                                    style="@style/Widget.FlowCloud.RowSubtitle"
                                    tools:text="Установлена версия 0.2.26" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/automatic_updates_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:checked="true"
                                android:contentDescription="@string/automatic_update_checks" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/update_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:trackCornerRadius="2dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/flow_outline" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/check_updates_button"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:gravity="start|center_vertical"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="16dp"
                            android:text="@string/check_updates"
                            android:textAllCaps="false"
                            android:textSize="15sp"
                            app:cornerRadius="0dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Widget.FlowCloud.SectionLabel"
                    android:layout_marginTop="20dp"
                    android:text="@string/settings_more_section" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FlowCloud.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/advanced_settings_button"
                            style="@style/Widget.FlowCloud.Row">

                            <ImageView
                                style="@style/Widget.FlowCloud.RowIcon"
                                android:src="@drawable/ic_tune_24" />

                            <TextView
                                style="@style/Widget.FlowCloud.RowTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/advanced_settings" />

                            <ImageView style="@style/Widget.FlowCloud.Chevron" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/flow_outline" />

                        <LinearLayout
                            android:id="@+id/save_logs_button"
                            style="@style/Widget.FlowCloud.Row">

                            <ImageView
                                style="@style/Widget.FlowCloud.RowIcon"
                                android:src="@drawable/ic_log_24" />

                            <TextView
                                style="@style/Widget.FlowCloud.RowTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/save_logs" />

                            <ImageView style="@style/Widget.FlowCloud.Chevron" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/flow_card_stroke" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/flow_surface"
        app:backgroundTint="@color/flow_surface"
        app:elevation="0dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_navigation" />
</LinearLayout>
